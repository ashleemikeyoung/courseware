# Copy to .env and fill in. .env itself should never be committed.

# On the Mac (where memory-db actually runs):
LIBSQL_URL=http://localhost:8080

# On alice, once you have the Mac's LAN IP:
# LIBSQL_URL=http://192.168.1.XXX:8080

# Same token on both machines -- generated by mint_token.py on the Mac,
# then copied to alice's .env.
LIBSQL_AUTH_TOKEN=
